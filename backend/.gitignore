# ==============================================================================
# JharkhandJobs - Backend Gitignore Configuration
# ==============================================================================

# Node dependencies
node_modules/

# Secrets and configuration environment variables (preserve .env.example)
.env
.env.*
.env.example
.env.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*

# Uploads directory - ignore uploaded resume files but preserve directories
uploads/*
!uploads/.gitkeep
uploads/resumes/*
!uploads/resumes/.gitkeep

# Temporary files
tmp/
temp/
*~
