# ---------------------------------------------------------------------------
# SarkariFynx API — environment
# Copy this file to `.env` and fill in your local values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- MySQL ------------------------------------------------------------------
# The database is created automatically on boot/seed if it does not exist,
# so you only need a running MySQL server and credentials that may CREATE.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sarkarifynx
DB_USER=root
DB_PASSWORD=
# Set to true to echo every generated SQL statement (noisy, useful when debugging).
DB_LOGGING=false

# --- Auth (admin JWT) --------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Seed admin account ------------------------------------------------------
# Created by `npm run seed`. Change the password before deploying anywhere real.
ADMIN_EMAIL=admin@sarkarifynx.in
ADMIN_PASSWORD=admin12345
ADMIN_NAME=SarkariFynx Admin

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins, or `*` to allow any.
CLIENT_ORIGIN=http://localhost:5173

# --- Google OAuth ------------------------------------------------------------
# REQUIRED for "Continue with Google". Create an OAuth 2.0 Client ID of type
# "Web application" at https://console.cloud.google.com/apis/credentials and add
# your frontend origin (e.g. http://localhost:5173) under
# "Authorized JavaScript origins". Without this the /api/auth/google endpoint
# returns 503 — it will not accept unverified ID tokens.
GOOGLE_CLIENT_ID=

# Not used by this server. The Google Identity Services flow verifies an ID
# token with the client ID alone; no client secret is needed. Never commit one.
# GOOGLE_CLIENT_SECRET=
