# ==============================================================================
# JharkhandJobs - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your environment configuration.

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database Configuration - Hostinger MySQL
# Web phpMyAdmin URL: https://auth-db1667.hstgr.io/index.php?db=u682864865_jharkhand_db
DB_HOST=
DB_USER=
DB_PASSWORD=your_mysql_password_here
DB_NAME=u682864865_jharkhand_db
DB_PORT=3306

# Alternative PostgreSQL (Optional)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jharkhand_jobs
# USE_POSTGRES=false

# JWT Authentication Secret
JWT_SECRET=supersecretjharkhandjobskey12345
SESSION_SECRET=supersecretsessionkey98765

# Google OAuth Configuration
GOOGLE_CLIENT_ID=976260447025-u5a4ki77guc06to3f0avpt4nfjphg25j.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Email Provider Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
