# ==============================================================================
# JharkhandJobs - Global Gitignore Configuration
# ==============================================================================

# Node.js dependencies
node_modules/
**/node_modules/

# Environment Variables & Secrets (Keep .env.example files)
.env
.env.*
.env.example
**/.env
**/.env.*
!**/.env.example

# Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log.temp

# Runtime & Process data
pids
*.pid
*.seed
*.pid.lock

# Build & Compilation Outputs
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.turbo/
**/dist/
**/dist-ssr/

# IDEs, Editors & Workspaces
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# File Uploads (Ignore uploaded user resumes & files, preserve directory structures)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep

# Temporary files
tmp/
temp/
*~
