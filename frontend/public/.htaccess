<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files directly (sitemap.xml, sitemap-*.xml, robots.txt, assets, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure correct XML MIME type and caching headers for search engines
<IfModule mod_mime.c>
  AddType application/xml .xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
